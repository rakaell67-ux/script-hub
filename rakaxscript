<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>script hub — rakaxscript</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #121029;
      min-height: 100vh;
      font-family: 'Segoe UI', system-ui, sans-serif;
      text-transform: lowercase;
      overflow: hidden; /* sembunyikan gulir body */
    }

    /* === JUDUL DIAM DI ATAS === */
    .header {
      text-align: center;
      padding: 30px 20px 20px;
      position: sticky;
      top: 0;
      background: linear-gradient(to bottom, #121029 70%, transparent);
      z-index: 10;
    }

    .judul {
      font-size: 34px;
      font-weight: 700;
      color: #c4b5fd;
      letter-spacing: 3px;
      text-shadow: 0 0 8px rgba(196, 181, 253, 0.6),
                   0 0 16px rgba(167, 139, 250, 0.4);
    }

    .judul span {
      display: inline-block;
      animation: kedip 2s ease-in-out infinite;
    }

    @keyframes kedip {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.7; transform: scale(0.95); }
    }

    /* === AREA LIST SCRIPT BISA DIGULIR === */
    .scroll-area {
      height: calc(100vh - 200px);
      overflow-y: auto;
      padding: 0 20px 20px;
    }

    .container {
      max-width: 500px;
      margin: 0 auto;
    }

    /* === KARTU SCRIPT === */
    .kartu {
      background: #1e1b4b;
      border: 2px solid #4f46e5;
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: 0 0 12px rgba(79, 70, 229, 0.25);
      transition: 0.3s ease;
    }

    .kartu:hover {
      border-color: #a855f7;
      transform: translateY(-2px);
    }

    .nama-script {
      font-size: 20px;
      font-weight: 700;
      color: #ddd6fe;
      margin-bottom: 4px;
    }

    .nama-game {
      font-size: 15px;
      color: #a5b4fc;
      margin-bottom: 14px;
    }

    .kotak-kode {
      background: #0f0d24;
      border-left: 4px solid #a855f7;
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 14px;
      font-family: 'Consolas', 'Courier New', monospace;
      font-size: 14px;
      color: #c7d2fe;
      line-height: 1.5;
      word-break: break-all;
      text-transform: none;
    }

    .btn-salin {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(90deg, #a855f7, #c084fc);
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.3s ease;
    }

    .btn-salin:hover {
      transform: scale(1.02);
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.5);
    }

    .btn-salin.sukses {
      background: linear-gradient(90deg, #10b981, #34d399);
    }

    /* === WATERMARK DIAM DI BAWAH === */
    .wm {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 9999;
      pointer-events: none;

      padding: 12px 30px;
      border: 2px solid;
      border-image: linear-gradient(90deg, 
        #ff6b6b, #feca57, #4ade80, #00d4ff, #a855f7, #ff6b6b) 1;

      font-size: 22px;
      font-weight: 900;
      letter-spacing: 3px;
      font-family: 'Varela Round', 'Arial Rounded MT Bold', 'Segoe UI Rounded', sans-serif;
      
      background: linear-gradient(90deg, 
        #ff6b6b, #feca57, #4ade80, #00d4ff, #a855f7, #ff6b6b);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      
      animation: pelangi 4s linear infinite;
      filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.4));
    }

    @keyframes pelangi {
      0% { background-position: 0% 50%; }
      100% { background-position: 300% 50%; }
    }

    /* === Gaya gulir === */
    .scroll-area::-webkit-scrollbar {
      width: 6px;
    }
    .scroll-area::-webkit-scrollbar-thumb {
      background: #4f46e5;
      border-radius: 3px;
    }
  </style>
</head>
<body>

<!-- JUDUL DIAM DI ATAS -->
<div class="header">
  <h1 class="judul">
    <span>✨</span> script hub <span>✨</span>
  </h1>
</div>

<!-- LIST SCRIPT BISA DIGULIR -->
<div class="scroll-area">
  <div class="container">
    <!-- SCRIPT 1 -->
    <div class="kartu">
      <div class="nama-script">auto farm</div>
      <div class="nama-game">blox fruits</div>
      <div class="kotak-kode" id="kode1">
loadstring(game:HttpGet('https://link-kamu-disini.com/auto-farm'))()
      </div>
      <button class="btn-salin" onclick="salinKode('kode1', this)">salin kode</button>
    </div>

    <!-- SCRIPT 2 -->
    <div class="kartu">
      <div class="nama-script">esp + aim</div>
      <div class="nama-game">murder mystery 2</div>
      <div class="kotak-kode" id="kode2">
loadstring(game:HttpGet('https://link-kamu-disini.com/esp-aim'))()
      </div>
      <button class="btn-salin" onclick="salinKode('kode2', this)">salin kode</button>
    </div>

    <!-- SCRIPT 3 -->
    <div class="kartu">
      <div class="nama-script">auto collect</div>
      <div class="nama-game">pet simulator 99</div>
      <div class="kotak-kode" id="kode3">
loadstring(game:HttpGet('https://link-kamu-disini.com/auto-collect'))()
      </div>
      <button class="btn-salin" onclick="salinKode('kode3', this)">salin kode</button>
    </div>

    <!-- TAMBAH SCRIPT BARU DI BAWAH INI -->
    <!--
    <div class="kartu">
      <div class="nama-script">nama script</div>
      <div class="nama-game">nama game</div>
      <div class="kotak-kode" id="kode4">
link-atau-kode-di-sini
      </div>
      <button class="btn-salin" onclick="salinKode('kode4', this)">salin kode</button>
    </div>
    -->
  </div>
</div>

<!-- WM DIAM DI BAWAH -->
<div class="wm">rakaxscript</div>

<script>
function salinKode(id, btn) {
  const teks = document.getElementById(id).innerText.trim();
  navigator.clipboard.writeText(teks).then(() => {
    const teksAwal = btn.innerText;
    btn.innerText = 'tersalin!';
    btn.classList.add('sukses');
    setTimeout(() => {
      btn.innerText = teksAwal;
      btn.classList.remove('sukses');
    }, 2000);
  });
}
</script>

</body>
</html>
